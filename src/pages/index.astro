---
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoCard from '../components/VideoCard.astro';
import { items as videos } from '../data/videos.json';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout>
  <!-- BANNER -->
  <section class="bg-[#1a2d5a]">
    <img
      src={`${base}imgs/banner.png`}
      alt="Công an phường Ngũ Hành Sơn – Hướng dẫn thủ tục đăng ký xe"
      class="block h-auto w-full"
    />
  </section>

  <!-- Instruction notice -->
  <div class="bg-[#1a2d5a] px-4 pb-8 pt-5">
    <div
      class="mx-auto flex max-w-2xl items-start gap-3 rounded-lg border border-white/20 bg-white/10 px-5 py-4"
    >
      <svg
        class="mt-0.5 h-5 w-5 shrink-0 text-yellow-400"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002
             6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388
             6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3
             0 11-6 0v-1m6 0H9"
        ></path>
      </svg>
      <p class="text-sm font-light leading-relaxed text-white/90 md:text-base">
        Công dân vui lòng xem hướng dẫn
        <strong class="font-medium text-yellow-400">loại thủ tục đang cần thực hiện</strong>
        qua video bên dưới trước khi tiến hành đăng ký.
      </p>
    </div>
  </div>

  <!-- Curved bottom edge -->
  <div class="bg-[#1a2d5a]">
    <svg
      viewBox="0 -1 1440 71"
      xmlns="http://www.w3.org/2000/svg"
      preserveAspectRatio="none"
      class="block w-full"
    >
      <path d="M0,-1 C360,70 1080,70 1440,-1 L1440,70 L0,70 Z" fill="#f9fafb"></path>
    </svg>
  </div>

  <!-- VIDEOS -->
  <main class="bg-gray-50 px-4 py-10 md:py-14">
    <div class="mx-auto max-w-5xl">
      <!-- Section label -->
      <div class="mb-8 flex items-center gap-3">
        <div class="h-7 w-1 rounded-full bg-red-600"></div>
        <h2 class="text-lg font-semibold uppercase tracking-wide text-[#1a2d5a] md:text-xl">
          Video hướng dẫn
        </h2>
      </div>

      <!-- Video grid -->
      <div class="grid gap-6 md:grid-cols-3 md:gap-8">
        {
          videos.map((video, i) => (
            <VideoCard
              index={i + 1}
              title={video.title}
              embedUrl={video.embedUrl}
              watchUrl={video.watchUrl}
              description={video.description}
            />
          ))
        }
      </div>

      <!-- Helper note -->
      <div
        class="mt-10 flex items-start gap-3 rounded-lg border border-blue-200 bg-blue-50 px-5 py-4"
      >
        <svg
          class="mt-0.5 h-5 w-5 shrink-0 text-blue-500"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <p class="text-sm font-light leading-relaxed text-blue-800">
          Nếu gặp khó khăn trong quá trình thực hiện thủ tục, công dân vui lòng liên hệ trực tiếp
          tại <strong class="font-medium">Công an phường Ngũ Hành Sơn</strong>
          để được hỗ trợ và hướng dẫn thêm.
        </p>
      </div>
    </div>
  </main>

  <!-- FOOTER -->
  <footer class="mt-4 bg-[#1a2d5a] px-4 py-6 text-white/70">
    <div class="mx-auto max-w-5xl space-y-1 text-center text-xs font-light leading-relaxed">
      <p class="text-sm font-medium text-white">CÔNG AN PHƯỜNG NGŨ HÀNH SƠN – THÀNH PHỐ ĐÀ NẴNG</p>
      <p>Hướng dẫn thực hiện thủ tục đăng ký xe trên Cổng Dịch vụ công Bộ Công An</p>
      <p class="mt-3 border-t border-white/10 pt-2">
        © 2026 Công an phường Ngũ Hành Sơn, TP. Đà Nẵng.
      </p>
    </div>
  </footer>
</BaseLayout>
